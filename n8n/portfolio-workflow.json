        [{"node": "Download Portfolio Image", "type": "main", "index": 0}],
        [{"node": "Send No-Image Reply", "type": "main", "index": 0}]
      ]
    },
    "Download Portfolio Image": {
      "main": [
        [{"node": "Prepare Base64", "type": "main", "index": 0}]
      ]
    },
    "Prepare Base64": {
      "main": [
        [{"node": "Claude Vision — Extract Portfolio", "type": "main", "index": 0}]
      ]
    },
    "Claude Vision — Extract Portfolio": {
      "main": [
        [{"node": "Parse & Build Sheet Rows", "type": "main", "index": 0}]
      ]
    },
    "Parse & Build Sheet Rows": {
      "main": [
        [{"node": "Append to Google Sheets", "type": "main", "index": 0}]
      ]
    },
    "Append to Google Sheets": {

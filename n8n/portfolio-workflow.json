        [{"node": "Respond 200 OK", "type": "main", "index": 0}]
      ]
    },
    "Send No-Image Reply": {
      "main": [
        [{"node": "Respond 200 OK (No Image)", "type": "main", "index": 0}]
      ]
    }
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "reymen-analytics"
  }
}
